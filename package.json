{
  "name": "marine-power-system-sim-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:hull": "blender --background --python scripts/blender/generate_hull.py",
    "build:prop": "blender --background --python scripts/blender/generate_propeller.py",
    "build:tx": "blender --background --python scripts/blender/generate_transformer.py",
    "build:pumps": "blender --background --python scripts/blender/generate_pumps.py",
    "check:layout": "node scripts/qa/check-layout.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "shot": "node scripts/qa/shot.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
